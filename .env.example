# Local development only. Copy to `.env` and edit; `.env` is gitignored, this is not.
#
# Nothing here is needed in production. Bloxity Legion injects its own values at
# runtime (see the bottom of this file), and Render takes its from render.yaml and
# the dashboard.

# Port to listen on. Legion, Render and most hosts set this for you - leave it unset
# there and let the host pick.
PORT=3000

# Extra browser origins allowed to open a lobby socket, comma separated.
#
# The two Vite dev origins are already built in (see src/server.js), and on Legion
# the game's own address arrives as CLIENT_ORIGIN, so this is only for the ones
# neither of those covers. Origins are exact - scheme, host and port all have to
# match, and there is no trailing slash.
#
#   the deployed game          https://clicperpower.netlify.app
#   a Netlify preview build    https://deploy-preview-7--clicperpower.netlify.app
#   your phone over Wi-Fi      http://192.168.1.5:5173
#
# ALLOWED_ORIGINS=https://clicperpower.netlify.app,http://192.168.1.5:5173

# --- What the platform sets, and what must never be written here -----------------
#
# Bloxity Legion provides these to the running container; do not hardcode or
# duplicate them:
#
#   PORT  NODE_ENV  CLIENT_ORIGIN  JWT_SECRET  MONGODB_URI
#   BLOXITY_GAME_ID  BLOXITY_CHANNEL  POD_NAME
#
# The deploy token is NOT one of them. It is a credential that pushes code to the
# live game, and it belongs in this repository's GitHub Actions secrets as
# LEGION_DEPLOY_TOKEN - nowhere else. This file is committed, so a token written
# here is a token published. If one ever does land here, deleting the line is not
# enough: regenerate the token on the Bloxity hosting page, because the old one is
# in the git history for good.
